--- a/.github/workflows/native-validation.yml	1969-12-31 17:00:00.000000000 -0700
+++ b/.github/workflows/native-validation.yml	2026-10-09 15:26:56.012998229 -0600
@@ -0,0 +1,84 @@
+# Dinner, Together — native validation without owning a Mac.
+#
+# Two jobs:
+#   engine-linux  (free, fast)  — runs the JS model and `swift test` on Linux via
+#                                 the Package.swift harness (engine + store tests).
+#   native-ios    (macOS runner) — builds the Xcode project, runs XCTest on an
+#                                 iPhone and an iPad simulator, and screenshots
+#                                 the seeded recovery states. Uploads everything
+#                                 as the "native-validation-results" artifact,
+#                                 whether or not the steps pass.
+#
+# Triggers on every push and manually (Actions tab → "Run workflow").
+name: native-validation
+
+on:
+  push:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  engine-linux:
+    name: Engine model + swift test (Linux)
+    runs-on: ubuntu-latest
+    container: swift:6.0
+    steps:
+      - uses: actions/checkout@v4
+      - name: Toolchain
+        run: swift --version
+      - name: swift test (Package.swift harness)
+        run: swift test 2>&1 | tee swift-test-linux.log
+      - name: Upload Linux log
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: engine-linux-log
+          path: swift-test-linux.log
+          if-no-files-found: ignore
+
+  js-model:
+    name: Supplemental JS model
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - run: node logic-checks/mirror-test.cjs
+      - run: node logic-checks/reconciliation-test.cjs
+
+  native-ios:
+    name: Xcode build, XCTest, simulator screenshots
+    runs-on: macos-15
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v4
+      - name: Xcode in use
+        run: |
+          xcodebuild -version
+          xcrun simctl list runtimes available | tail -n +1
+      - name: Build + XCTest (iPhone and iPad simulators) + swift test
+        run: bash native-validation/run-native-pass.sh "$GITHUB_WORKSPACE/native-validation/results"
+      - name: Screenshots of seeded recovery states
+        if: always()
+        run: bash native-validation/screenshots.sh "$GITHUB_WORKSPACE/native-validation/results"
+      - name: Show summary
+        if: always()
+        run: cat native-validation/results/SUMMARY.md || true
+      - name: Upload results
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: native-validation-results
+          path: |
+            native-validation/results/**
+            !native-validation/results/build/**
+          if-no-files-found: warn
+      - name: Fail the job if a test step failed
+        if: always()
+        run: |
+          if grep -q '❌' native-validation/results/SUMMARY.md 2>/dev/null; then
+            echo "One or more steps failed — see SUMMARY.md in the artifact."; exit 1
+          fi
