 /// Selected explicitly for Duo native-window validation. Kept outside the
 /// ordinary iPhone/iPad classes and their discovery counts. This checks real
 /// window fit; device/scene orientation is diagnostic, not a layout override.
 final class DinnerTogetherDuoWindowTests: DinnerTogetherUITestCase {
     func test01_wideNativeWindowCookbookSpread() {
+        // Exact observed false-positive plus malformed/missing/error regressions.
+        let frame = CGRect(x: 0, y: 0, width: 678, height: 466)
+        let good = "phase=observed;orientation=portrait;window=678x466;scene=678x466;error=none"
+        XCTAssertTrue(DuoWindowGeometry.accepts(status: good, frame: frame))
+        for invalid in [
+            good.replacingOccurrences(of: "scene=678x466", with: "scene=466x678"),
+            good.replacingOccurrences(of: "scene=678x466;", with: ""),
+            good.replacingOccurrences(of: "scene=678x466", with: "scene=nanx466"),
+            good.replacingOccurrences(of: "scene=678x466", with: "scene=678x0"),
+            good.replacingOccurrences(of: "scene=678x466", with: "scene=700x466"),
+            good.replacingOccurrences(of: "phase=observed", with: "phase=error"),
+            good.replacingOccurrences(of: "phase=observed", with: "phase=requested"),
+            good.replacingOccurrences(of: "error=none", with: "error=UIKit:101:denied"),
+            good + ";scene=466x678", "probe absent"
+        ] {
+            XCTAssertFalse(DuoWindowGeometry.accepts(status: invalid, frame: frame), invalid)
+        }
         flowCookbookSpread(requireWideNativeWindow: true)
     }
 }
