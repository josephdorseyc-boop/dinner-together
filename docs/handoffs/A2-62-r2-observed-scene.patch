+    /// A2-62: the window and scene must agree. A landscape-only mask can
+    /// produce a wide window drawn sideways inside a narrow scene.
+    private func wideSceneStatus() -> String {
+        let probe = app.descendants(matching: .any)["dt-scene-geometry-status"].firstMatch
+        return probe.exists ? ((probe.value as? String) ?? probe.label) : "probe absent"
+    }
+
+    private func hasUsableWideScene() -> Bool {
+        DuoWindowGeometry.accepts(status: wideSceneStatus(), frame: app.frame)
+    }
+
+    /// Geometry and accessibility are automated clipping checks, not a pixel
+    /// oracle. Retain the full capture for visual rail/safe-area inspection.
+    private func firstScreenFitsWideScene() -> Bool {
+        guard hasUsableWideScene() else { return false }
+        let frame = app.frame
+        let image = app.screenshot().image.size
+        guard image.width.isFinite, image.height.isFinite, image.height > 0,
+              abs(image.width / image.height - frame.width / frame.height) <= 0.02 else { return false }
+        let entry = app.buttons["open-recipes"].firstMatch
+        guard entry.exists, entry.isHittable, isFiniteFrame(entry.frame) else { return false }
+        return frame.insetBy(dx: -1, dy: -1).contains(entry.frame)
+    }
