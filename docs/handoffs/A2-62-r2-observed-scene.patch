+/// Strict parsing fails closed for absent, stale-error, ambiguous or malformed telemetry.
+private enum DuoWindowGeometry {
+    static func accepts(status: String, frame: CGRect) -> Bool {
+        var fields: [String: String] = [:]
+        for item in status.split(separator: ";") {
+            let parts = item.split(separator: "=", maxSplits: 1, omittingEmptySubsequences: false)
+            guard parts.count == 2 else { return false }
+            let key = String(parts[0]).trimmingCharacters(in: .whitespaces)
+            guard fields[key] == nil else { return false }
+            fields[key] = String(parts[1]).trimmingCharacters(in: .whitespaces)
+        }
+        guard fields["phase"] == "observed", fields["error"] == "none",
+              let scene = size(fields["scene"]), let window = size(fields["window"]),
+              frame.origin.x.isFinite, frame.origin.y.isFinite,
+              frame.width.isFinite, frame.height.isFinite,
+              frame.width > frame.height, frame.width >= 600, frame.height >= 450,
+              window.width >= 600, window.height >= 450,
+              scene.width > scene.height, scene.width >= 600, scene.height >= 450,
+              window.width > window.height,
+              abs(scene.width - window.width) <= 2, abs(scene.height - window.height) <= 2,
+              abs(window.width - frame.width) <= 2, abs(window.height - frame.height) <= 2 else { return false }
+        return true
+    }
+
+    private static func size(_ text: String?) -> CGSize? {
+        guard let text else { return nil }
+        let parts = text.split(separator: "x", omittingEmptySubsequences: false)
+        guard parts.count == 2, let w = Double(parts[0]), let h = Double(parts[1]),
+              w.isFinite, h.isFinite, w > 0, h > 0 else { return nil }
+        return CGSize(width: CGFloat(w), height: CGFloat(h))
+    }
+}
